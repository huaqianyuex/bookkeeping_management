{
  "name": "smart-ledger-backend",
  "version": "1.0.0",
  "description": "智能记账分析系统 - 后端服务（基于 Agnes AI 的 AI 记账助手）",
  "type": "module",
  "main": "server/index.ts",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "node --loader tsx server/index.ts",
    "build": "tsc --module node16 --moduleResolution node16 --target es2022 --esModuleInterop --strict --outDir dist"
  },
  "keywords": [
    "ledger",
    "ai",
    "chat",
    "agnes",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "sql.js": "^1.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
