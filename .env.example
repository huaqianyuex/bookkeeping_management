# 复制为 .env 并填写（docker compose 自动读取本文件）

# MySQL root 密码（容器初始化与后端连接共用）
MYSQL_ROOT_PASSWORD=change-me

# JWT 签名密钥：至少 32 位的随机字符串，上线前务必更换
JWT_SECRET=please-generate-a-random-32-char-secret

# AI（可选，不配置则仅 AI 功能不可用）
AGNES_API_KEY=
OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
CHAT_MODEL=agnes-2.5-flash
ANALYZE_MODEL=agnes-2.0-flash
EMBEDDING_MODEL=text-embedding-3-small
