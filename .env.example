# 复制为 .env 并填写（docker compose 自动读取本文件）

# MySQL root 密码（容器初始化与后端连接共用；务必改成你自己的强密码）
MYSQL_ROOT_PASSWORD=change-me

# JWT 签名密钥：至少 32 位的随机字符串，上线前务必更换
JWT_SECRET=please-generate-a-random-32-char-secret

# AI（可选，不配置则仅 AI 功能不可用）
AGNES_API_KEY=
OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
CHAT_MODEL=agnes-2.5-flash
ANALYZE_MODEL=agnes-2.0-flash
EMBEDDING_MODEL=text-embedding-3-small

# 充值/审批（可选，不配置则使用代码内默认值与派生回调密钥）
# 单笔/当日累计人工审批阈值（元）；达到阈值或命中异常规则的订单转管理员人工审核
RECHARGE_MANUAL_REVIEW_AMOUNT=100
RECHARGE_DAILY_REVIEW_AMOUNT=200
# 支付回调 HMAC 密钥：不配置时从 JWT_SECRET 派生；生产建议显式设置独立随机值
RECHARGE_CALLBACK_SECRET=
